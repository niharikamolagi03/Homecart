# Copy this file to .env before starting the Django API.
# Use a long, random value for SECRET_KEY in every deployed environment.
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3

# In production, use your deployed frontend URL and set DEBUG=False.
CORS_ALLOWED_ORIGINS=http://localhost:5173
